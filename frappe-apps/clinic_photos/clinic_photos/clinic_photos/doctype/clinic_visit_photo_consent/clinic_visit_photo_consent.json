{
 "doctype": "DocType",
 "name": "Clinic Visit Photo Consent",
 "module": "Clinic Photos",
 "autoname": "hash",
 "engine": "InnoDB",
 "track_changes": 1,
 "allow_rename": 0,
 "field_order": ["appointment", "patient", "evidence", "granted_by", "granted_at", "revoked", "revoked_by", "revoked_at", "checked_in_at", "checkin_witness_at"],
 "fields": [
  {"fieldname": "appointment", "fieldtype": "Link", "options": "Patient Appointment", "label": "Appointment", "reqd": 1, "unique": 1, "no_copy": 1},
  {"fieldname": "patient", "fieldtype": "Link", "options": "Patient", "label": "Patient", "reqd": 1, "no_copy": 1},
  {"fieldname": "evidence", "fieldtype": "Data", "label": "Consent Evidence Reference", "reqd": 1, "no_copy": 1},
  {"fieldname": "granted_by", "fieldtype": "Link", "options": "User", "label": "Granted By", "read_only": 1, "no_copy": 1},
  {"fieldname": "granted_at", "fieldtype": "Datetime", "label": "Granted At", "read_only": 1, "no_copy": 1},
  {"fieldname": "revoked", "fieldtype": "Check", "label": "Revoked", "default": "0", "no_copy": 1},
  {"fieldname": "revoked_by", "fieldtype": "Link", "options": "User", "label": "Revoked By", "read_only": 1, "no_copy": 1},
  {"fieldname": "revoked_at", "fieldtype": "Datetime", "label": "Revoked At", "read_only": 1, "no_copy": 1},
  {"fieldname": "checked_in_at", "fieldtype": "Datetime", "label": "Legacy Check In Observation", "read_only": 1, "no_copy": 1},
  {"fieldname": "checkin_witness_at", "fieldtype": "Datetime", "label": "Native Check In Witness", "read_only": 1, "no_copy": 1}
 ],
 "permissions": [
  {"role": "Physician", "read": 1, "write": 1, "create": 1},
  {"role": "Healthcare Administrator", "read": 1, "write": 1, "create": 1}
 ]
}
